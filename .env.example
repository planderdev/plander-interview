# 플랜더 웍스와 같은 Supabase 프로젝트(hmjbbdwzwiqihqhjtspd)
# 비워 두면 목업 모드로 실행됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 의뢰 전환 후 웍스 프로젝트로 이동할 주소
NEXT_PUBLIC_WORKS_URL=https://plander-works.vercel.app

# 목업 모드에서 볼 사용자 (m1 슈퍼운영자, m2 운영자, m3 팀원)
MOCK_USER_ID=m1

# 견적서 PDF 비밀번호. 비워 두면 PDF로 뽑을 수 없습니다.
QUOTE_PDF_PASSWORD=
# 직인 PNG 를 base64 로 넣습니다. 비워 두면 private/plander-seal.png 를 찾고, 없으면 직인 없이 나옵니다.
SEAL_PNG_BASE64=
